<?xml version="1.0" encoding="utf-8"?>
<!--
  Marble Madness Android host: one Activity, one WebView showing https://marbles.secure.build, a JavaScript
  bridge (window.NativeBridge) for rich haptics and the browser login, a native title overlay for frame 1,
  and a pre-warmed Chrome Custom Tab.

  ${appLabel} ${serverOrigin} ${oauthScheme} are placeholders: Gradle fills them from manifestPlaceholders,
  build.sh fills them with sed. package / versionCode / uses-sdk are deliberately absent (AGP 9 forbids them
  here); Gradle takes them from defaultConfig and build.sh passes them to aapt2.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Package visibility (API 30+): needed for bindService() to the browser's Custom Tabs service -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="${appLabel}"
        android:icon="@mipmap/ic"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <!-- read by MainActivity at start -->
        <meta-data android:name="build.secure.marbles.SERVER_ORIGIN" android:value="${serverOrigin}" />
        <!-- true = WebView remote debugging (chrome://inspect) for profiling on a real phone; never for store builds -->
        <meta-data android:name="build.secure.marbles.DEBUG_WEBVIEW" android:value="${debugWebView}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- the server's /callback/<provider> hands the login result back here:
                 ${oauthScheme}://oauth-callback?user=..&provider=..&state=<nonce>   (or &error=..) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${oauthScheme}" android:host="oauth-callback" />
            </intent-filter>
        </activity>
    </application>
</manifest>
