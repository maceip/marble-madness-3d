{
  "name": "marble-madness-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Faithful web remake of Marble Madness: arcade stage art, NES gameplay rules, 1P / Player-vs-AI (WebMCP) / multi-marble modes.",
  "scripts": {
    "assets": "python3 tools/prep_assets.py && python3 tools/gen_frames.py",
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "serve": "node tools/serve.mjs",
    "start": "npm run build && npm run serve",
    "check": "tsc --noEmit -p tsconfig.json",
    "levels:dump": "node tools/dump_levels.mjs",
    "levels:overlay": "npm run levels:dump && python3 tools/level_overlay.py",
    "test:physics": "node tools/test_level_physics.mjs",
    "test:chrome-agent": "node tools/test_chrome_agent.mjs",
    "test:android-install:prod": "node tools/prod_android_install.mjs",
    "test:ai-tracker:prod": "BASE=https://marbles.secure.build OUT=artifacts/prod-ai-tracker-mobile.png node tools/ai_tracker_visual.mjs",
    "test:magic-moment:prod": "BASE=https://marbles.secure.build node tools/magic_moment_e2e.mjs",
    "test:fold:prod": "BASE=https://marbles.secure.build node tools/test_fold.mjs",
    "test:fold-taps:prod": "SIZES=fold-open BASE=https://marbles.secure.build node tools/tap_flows.mjs",
    "test": "node tools/test_level_physics.mjs && node tools/smoke_all.mjs && node tools/flow_check.mjs && node tools/test_lobby.mjs && node tools/test_mobile_viewport.mjs",
    "check:prod": "node tools/prod_check.mjs",
    "lint": "npm run check && for f in tools/*.mjs; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "playwright-core": "1.62.1",
    "typescript": "^5.0.0"
  }
}
